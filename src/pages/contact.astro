---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout
	title="Contact — Portfolio de photographe"
	description="Informations de contact à compléter lorsque les coordonnées du photographe seront disponibles."
>
	<main id="contenu" class="gallery-page">
		<nav class="breadcrumbs" aria-label="Fil d’Ariane">
			<a href="/">Accueil</a>
			<span aria-hidden="true">/</span>
			<span aria-current="page">Contact</span>
		</nav>

		<header class="gallery-page-header">
			<p class="eyebrow">Contact · Informations à compléter</p>
			<h1>Parlons de votre projet.</h1>
			<p>
				Les coordonnées du photographe ne sont pas encore disponibles. Cette
				page ne contient donc pas de moyen de contact actif.
			</p>
		</header>

		<section class="contact-section" aria-labelledby="titre-coordonnees">
			<div>
				<p class="eyebrow">Coordonnées</p>
				<h2 id="titre-coordonnees">Adresse e-mail à fournir</h2>
			</div>
			<p>
				Aucun formulaire n’est configuré. Un moyen de contact sera ajouté après
				validation des coordonnées et du service à utiliser.
			</p>
		</section>
	</main>
</SiteLayout>
