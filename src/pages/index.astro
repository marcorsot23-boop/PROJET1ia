---
import SiteLayout from "../layouts/SiteLayout.astro";
---

<SiteLayout>
	<main id="contenu">
		<section class="hero" id="accueil" aria-labelledby="titre-principal">
			<div class="hero__copy">
				<p class="eyebrow">Portfolio photographique · Projet de démonstration</p>
				<h1 id="titre-principal">Des histoires humaines, en images.</h1>
				<p class="hero__intro">
					Portrait, mode et lifestyle — textes et identité à valider avec le
					photographe.
				</p>
				<a class="text-link" href="#portfolio">Découvrir les séries <span aria-hidden="true">↘</span></a>
			</div>
			<figure class="hero__image">
				<img
					src="/images/portrait-demo.webp"
					width="1200"
					height="1500"
					alt="Portrait de démonstration d’une femme de profil, éclairée sur fond sombre"
					fetchpriority="high"
				/>
				<figcaption>Image de démonstration — Unsplash</figcaption>
			</figure>
		</section>

		<section class="portfolio-section" id="portfolio" aria-labelledby="titre-portfolio">
			<div class="section-heading">
				<p class="eyebrow">Sélection</p>
				<h2 id="titre-portfolio">Explorer les séries</h2>
			</div>
			<div class="category-grid">
				<a class="category-card" href="/portfolio/portraits/">
					<img
						class="category-card__image"
						src="/images/portrait-demo.webp"
						width="1200"
						height="1500"
						alt=""
						loading="lazy"
						decoding="async"
					/>
					<span class="category-card__number">01</span>
					<span class="category-card__title">Portraits</span>
					<span class="category-card__note">Découvrir la série</span>
				</a>
				<a class="category-card" href="/portfolio/mode/">
					<img
						class="category-card__image"
						src="/images/fashion-sample-03.webp"
						width="1000"
						height="1250"
						alt=""
						loading="lazy"
						decoding="async"
					/>
					<span class="category-card__number">02</span>
					<span class="category-card__title">Mode</span>
					<span class="category-card__note">Découvrir la série</span>
				</a>
				<a class="category-card" href="/portfolio/lifestyle/">
					<img
						class="category-card__image"
						src="/images/lifestyle-sample-01.webp"
						width="1000"
						height="1250"
						alt=""
						loading="lazy"
						decoding="async"
					/>
					<span class="category-card__number">03</span>
					<span class="category-card__title">Lifestyle</span>
					<span class="category-card__note">Découvrir la série</span>
				</a>
			</div>
		</section>

		<section class="text-section" aria-labelledby="titre-a-propos">
			<p class="eyebrow">À propos</p>
			<h2 id="titre-a-propos">Une présentation à écrire avec le photographe.</h2>
			<p>
				Les informations personnelles seront ajoutées après validation par le
				photographe.
			</p>
			<a class="text-link" href="/a-propos/">Découvrir la présentation <span aria-hidden="true">↗</span></a>
		</section>

		<section class="contact-section" aria-labelledby="titre-contact">
			<div>
				<p class="eyebrow">Contact</p>
				<h2 id="titre-contact">Parlons de votre projet.</h2>
			</div>
			<a class="text-link" href="/contact/">Voir les informations de contact <span aria-hidden="true">↗</span></a>
		</section>
	</main>
</SiteLayout>
